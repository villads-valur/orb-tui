# Ghostty settings for the README screenshots (loaded instead of your own config)
theme = Atom One Dark
font-family = "SFMono Nerd Font"
font-size = 12
window-width = 112
window-height = 32
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = native
title = orb-tui
cursor-style = bar
fullscreen = false
confirm-close-surface = false
quit-after-last-window-closed = true
